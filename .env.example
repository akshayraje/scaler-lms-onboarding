# --- Database -------------------------------------------------------------
# Any Postgres 14+. docker-compose overrides this to point at its own db.
DATABASE_URL=postgres://lms:lms@localhost:5433/lms

# --- Auth (Auth.js + Google) ----------------------------------------------
# Encrypts/signs auth cookies. Generate: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the app. Optional (derived from the request otherwise), but set
# it in production. Google redirect URI must be  <AUTH_URL>/api/auth/callback/google
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google Workspace accounts on this domain may sign in.
COMPANY_DOMAIN=scaler.com
# Comma-separated; these users are promoted to the admin role on sign-in.
ADMIN_EMAILS=

# --- Optional -------------------------------------------------------------
# Source DB for scripts/import-legacy.ts (the old Vercel Postgres instance).
LEGACY_DATABASE_URL=

# --- Background jobs & integrations ------------------------------------------
# Timezone for job schedules and dates in messages.
APP_TIMEZONE=Asia/Kolkata
# Set to "off" on instances that shouldn't run scheduled jobs.
JOBS_RUNNER=inline

# --- Notification channels ----------------------------------------------------
# Slack bot token (scopes: chat:write, users:read, users:read.email). Leave empty to disable Slack.
SLACK_BOT_TOKEN=
# SMTP. Email is enabled when SMTP_HOST and SMTP_FROM_EMAIL are set.
# docker compose defaults these to the local Mailpit catcher (http://localhost:8025).
SMTP_HOST=
# Empty = 587 (or 1025 for the local Mailpit when SMTP_HOST is empty under docker compose)
SMTP_PORT=
# true = TLS from the start (port 465); false = STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Scaler Learning
SMTP_FROM_EMAIL=

# --- HRMS (Darwinbox employee master) ------------------------------------------
# darwinbox | mock | none. Defaults to darwinbox when DARWINBOX_API_KEY is set.
# "mock" returns a few sample new joiners for local testing.
HRMS_PROVIDER=
DARWINBOX_BASE_URL=
DARWINBOX_USERNAME=
DARWINBOX_PASSWORD=
DARWINBOX_API_KEY=
DARWINBOX_DATASET_KEY=
